# PakTradeX Backend — Environment Variables
# Copy this file to .env and fill in your values

# ── AI ──────────────────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── Database ─────────────────────────────────────────────────────
# SQLite (development default — no setup required):
DATABASE_URL=sqlite+aiosqlite:///./paktradex.db
# PostgreSQL (Railway / Render production):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/paktradex

# ── Security ─────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-256-bit-secret-in-production

# ── CORS ─────────────────────────────────────────────────────────
# Use * for development; restrict to your domain in production
CORS_ORIGINS=["*"]

# ── Server ───────────────────────────────────────────────────────
PORT=8000
