# PakTradeX Backend — Environment Variables
# Copy this file to .env and fill in your values

# ── AI ──────────────────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── Database ─────────────────────────────────────────────────────
# SQLite (development default — no setup required):
DATABASE_URL=sqlite+aiosqlite:///./paktradex.db

# ── Security ─────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-256-bit-secret-in-production

# ── Real Email OTP Dispatch (Gmail / SMTP / SendGrid) ────────────
# For Gmail: Use your Gmail address and 16-character App Password (from myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_NAME="PakTradeX Security"
EMAILS_FROM_EMAIL=

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=["*"]

# ── Server ───────────────────────────────────────────────────────
PORT=8000
